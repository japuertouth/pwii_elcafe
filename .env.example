# Copia este archivo como .env (en la raíz del proyecto) y complétalo.
# En Vercel, define estas mismas variables en Project Settings → Environment Variables.
# NUNCA subas el archivo .env a GitHub ni pongas contraseñas en el README.

PORT=4000

# Base de datos Azure SQL
DB_HOST=tu-servidor.database.windows.net
DB_PORT=1433
DB_NAME=nombre_de_la_base
DB_USER=usuario
DB_PASSWORD=

# Clave para firmar los tokens (mínimo 32 caracteres). Genérala con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

ADMIN_ROL_ID=1
USUARIO_ROL_ID=2

# Costo de bcrypt (10 a 14). 12 es un buen equilibrio entre seguridad y velocidad.
BCRYPT_COSTO=12

# Límites contra fuerza bruta y abuso (opcionales)
AUTH_LIMITE_MINUTOS=15
AUTH_LIMITE_INTENTOS=10
LOGIN_MAX_FALLOS=5
LOGIN_MINUTOS_BLOQUEO=15
REGISTRO_LIMITE_POR_HORA=5
CONTACTO_LIMITE=5
API_LIMITE_PETICIONES=300

# Correo (recuperar contraseña y avisos de contacto) — SMTP de una cuenta que ya tengan.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y en SMTP_PASS una "contraseña de aplicación"
#        (myaccount.google.com → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones).
# Outlook/Office 365 (incluye correos institucionales): SMTP_HOST=smtp.office365.com, SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remitente que verá la gente (normalmente el mismo SMTP_USER)
CORREO_REMITENTE=
# Correo del equipo que recibe un aviso por cada mensaje de contacto (puede ser vacío)
CORREO_AVISOS=
# Dirección pública del sitio para los enlaces de los correos. En Vercel se detecta sola.
SITIO_URL=

# Solo si el frontend vive en OTRO dominio (separados por comas). Vacío = solo el mismo dominio.
CORS_ORIGIN=
